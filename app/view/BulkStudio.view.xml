<mvc:View
    controllerName="hanamorph.controller.BulkStudio"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form">
    <Page
        id="bulkStudioPage"
        title="Bulk Processing &amp; Deduplication Studio"
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true">
        <headerContent>
            <ObjectStatus
                text="{i18n>connStatusMock}"
                state="Warning"
                icon="sap-icon://alert"
                visible="{system>/useMock}"
                class="sapUiSmallMarginEnd" />
            <ObjectStatus
                text="{= ${system>/hanaConnected} ? ${i18n>connStatusConnected} : ${i18n>connStatusDisconnected} }"
                state="{= ${system>/hanaConnected} ? 'Success' : 'Error' }"
                icon="{= ${system>/hanaConnected} ? 'sap-icon://connected' : 'sap-icon://disconnected' }" />
        </headerContent>
        <content>
            <VBox width="100%" alignItems="Center" class="sapUiMediumMarginTop sapUiLargeMarginBottom">
                <VBox width="96%" class="sapUiResponsiveMargin">

                    <!-- 3-STEP BULK WIZARD TABS -->
                    <IconTabBar
                        id="bulkTabBar"
                        selectedKey="{bulkModel>/selectedTabKey}"
                        select=".onTabSelect"
                        headerMode="Inline"
                        expandable="false"
                        applyContentPadding="false">
                        <items>

                            <!-- ============================================================== -->
                            <!-- STEP 1: MULTI-VIEW CATALOG SELECTION                           -->
                            <!-- ============================================================== -->
                            <IconTabFilter
                                key="tabCatalog"
                                icon="sap-icon://checklist-item"
                                text="1. Select Views Catalog"
                                count="{bulkModel>/selectedCount}">
                                <content>
                                    <VBox class="sapUiMediumMargin" busy="{bulkModel>/isCatalogBusy}" busyIndicatorDelay="0">
                                        <MessageStrip
                                            text="Import all available CDS and Calculation Views from your source catalog. Select 2 or more views to analyze source overlap, detect duplicate physical tables, and generate harmonized Datasphere models."
                                            type="Information"
                                            showIcon="true"
                                            class="sapUiSmallMarginBottom" />

                                        <!-- Selection Action Toolbar -->
                                        <Toolbar class="sapUiSmallMarginBottom">
                                            <Button
                                                text="Import All Catalog Views"
                                                icon="sap-icon://synchronize"
                                                type="Emphasized"
                                                press=".onLoadCatalog" />
                                            <ToolbarSeparator />
                                            <Button
                                                text="Select All"
                                                icon="sap-icon://multiselect-all"
                                                press=".onSelectAllViews"
                                                enabled="{bulkModel>/hasCatalogLoaded}" />
                                            <Button
                                                text="Select Sample Set"
                                                icon="sap-icon://filter"
                                                press=".onSelectSampleViews"
                                                enabled="{bulkModel>/hasCatalogLoaded}" />
                                            <Button
                                                text="Clear Selection"
                                                icon="sap-icon://clear-all"
                                                press=".onClearSelection"
                                                enabled="{bulkModel>/hasCatalogLoaded}" />
                                            <ToolbarSpacer />
                                            <SearchField
                                                width="320px"
                                                placeholder="Search views by name or source..."
                                                search=".onSearchCatalog"
                                                liveChange=".onSearchCatalog" />
                                            <ObjectStatus
                                                text="{= ${bulkModel>/selectedCount} + ' of ' + ${bulkModel>/totalCatalogCount} + ' views selected' }"
                                                state="{= ${bulkModel>/selectedCount} >= 2 ? 'Success' : 'None' }" />
                                        </Toolbar>

                                        <!-- Multi-Select Views Table -->
                                        <Table
                                            id="bulkCatalogTable"
                                            mode="MultiSelect"
                                            selectionChange=".onViewSelectionChange"
                                            items="{
                                                path: 'bulkModel>/catalog',
                                                sorter: { path: 'name' }
                                            }"
                                            noDataText="Click 'Import All Catalog Views' to load available CDS and Calculation Views.">
                                            <headerToolbar>
                                                <OverflowToolbar>
                                                    <Title text="Available Views Catalog" level="H5" />
                                                    <ToolbarSpacer />
                                                    <Text text="Tip: Select overlapping views (e.g. Sales, Billing, and Confirmation) to observe automatic deduplication." class="text-muted" />
                                                </OverflowToolbar>
                                            </headerToolbar>
                                            <columns>
                                                <Column width="260px">
                                                    <Text text="View Technical Name" />
                                                </Column>
                                                <Column width="150px" hAlign="Center">
                                                    <Text text="View Type" />
                                                </Column>
                                                <Column width="220px">
                                                    <Text text="Underlying Sources" />
                                                </Column>
                                                <Column width="110px" hAlign="Center">
                                                    <Text text="Columns" />
                                                </Column>
                                                <Column>
                                                    <Text text="Description / Grain" />
                                                </Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem selected="{bulkModel>isSelected}">
                                                    <cells>
                                                        <Text text="{bulkModel>name}" class="sapUiBold" />
                                                        <ObjectStatus
                                                            text="{= ${bulkModel>type} === 'CALC_VIEW' ? 'Calculation View' : 'CDS View' }"
                                                            state="{= ${bulkModel>type} === 'CALC_VIEW' ? 'Information' : 'Success' }"
                                                            icon="{= ${bulkModel>type} === 'CALC_VIEW' ? 'sap-icon://dimension' : 'sap-icon://source-code' }" />
                                                        <Text text="{bulkModel>sourcesDisplay}" />
                                                        <Text text="{bulkModel>columnCount}" />
                                                        <Text text="{bulkModel>description}" />
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>

                                        <!-- Step 1 Footer Toolbar -->
                                        <Toolbar class="sapUiMediumMarginTop">
                                            <ToolbarSpacer />
                                            <Button
                                                text="Analyze Duplicates &amp; Lineage (Step 2)"
                                                icon="sap-icon://navigation-right-arrow"
                                                iconFirst="false"
                                                type="Emphasized"
                                                enabled="{= ${bulkModel>/selectedCount} >= 2 }"
                                                press=".onGoToStep2" />
                                        </Toolbar>
                                    </VBox>
                                </content>
                            </IconTabFilter>

                            <!-- ============================================================== -->
                            <!-- STEP 2: LINEAGE & DUPLICATE RATIONALIZATION CANVAS             -->
                            <!-- ============================================================== -->
                            <IconTabFilter
                                key="tabDeduplication"
                                icon="sap-icon://chain-link"
                                text="2. Deduplication &amp; Overlap Canvas"
                                enabled="{bulkModel>/hasAnalyzed}">
                                <content>
                                    <VBox class="sapUiMediumMargin" busy="{bulkModel>/isAnalyzeBusy}" busyIndicatorDelay="0">
                                        <!-- Instructions Banner -->
                                        <MessageStrip
                                            text="Deduplication Control: When multiple views reference the same physical table (e.g. VBAK, MARA, VBAP), choosing [BLOCK DUPLICATE] merges it into a single shared table in Datasphere (avoiding duplicate replication). Choosing [KEEP DUPLICATE] retains isolated per-view copies."
                                            type="Information"
                                            showIcon="true"
                                            class="sapUiSmallMarginBottom" />

                                        <!-- Rationalization Summary Bar -->
                                        <HBox justifyContent="SpaceAround" wrap="Wrap" class="sapUiSmallMarginBottom sapUiSmallPadding" style="border: 1px solid #d9e2ec; border-radius: 6px; background: #f8fafc;">
                                            <VBox alignItems="Center">
                                                <Title text="{bulkModel>/report/totalViewsAnalyzed}" level="H3" />
                                                <Text text="Views Analyzed" class="text-muted" />
                                            </VBox>
                                            <VBox alignItems="Center">
                                                <Title text="{bulkModel>/report/uniqueSourcesFound}" level="H3" />
                                                <Text text="Unique Base Tables" class="text-muted" />
                                            </VBox>
                                            <VBox alignItems="Center">
                                                <Title text="{bulkModel>/report/duplicateSourceCount}" level="H3" />
                                                <Text text="Duplicate Tables Detected" class="text-muted" />
                                            </VBox>
                                            <VBox alignItems="Center">
                                                <Title text="{bulkModel>/blockedCount}" level="H3" class="text-success" />
                                                <Text text="Blocked (Merged into Star Schema)" class="text-muted" />
                                            </VBox>
                                            <VBox alignItems="Center">
                                                <Title text="{bulkModel>/keptCount}" level="H3" class="text-warning" />
                                                <Text text="Kept (Isolated Copies)" class="text-muted" />
                                            </VBox>
                                        </HBox>

                                        <!-- Batch Actions Toolbar -->
                                        <Toolbar class="sapUiSmallMarginBottom">
                                            <Button
                                                text="Block All Duplicates (Consolidate into Star Schema)"
                                                icon="sap-icon://accept"
                                                type="Emphasized"
                                                press=".onBlockAllDuplicates" />
                                            <Button
                                                text="Keep All Duplicates (Full Isolation)"
                                                icon="sap-icon://decline"
                                                type="Default"
                                                press=".onKeepAllDuplicates" />
                                            <ToolbarSpacer />
                                            <Button
                                                text="Re-scan Lineage"
                                                icon="sap-icon://refresh"
                                                press=".onRescanDuplicates" />
                                        </Toolbar>

                                        <!-- Duplicate Overlaps & Decision Matrix -->
                                        <Table
                                            id="deduplicationTable"
                                            items="{bulkModel>/report/overlaps}"
                                            class="sapUiSmallMarginBottom">
                                            <headerToolbar>
                                                <OverflowToolbar>
                                                    <Title text="Detected Shared Physical Tables &amp; Columns" level="H5" />
                                                    <ToolbarSpacer />
                                                    <Text text="{= ${bulkModel>/report/overlaps}.length + ' physical tables evaluated' }" />
                                                </OverflowToolbar>
                                            </headerToolbar>
                                            <columns>
                                                <Column width="180px">
                                                    <Text text="Source Physical Table" />
                                                </Column>
                                                <Column width="120px" hAlign="Center">
                                                    <Text text="References" />
                                                </Column>
                                                <Column width="260px">
                                                    <Text text="Referencing Views (Lineage)" />
                                                </Column>
                                                <Column width="200px">
                                                    <Text text="Overlapping Columns" />
                                                </Column>
                                                <Column width="160px">
                                                    <Text text="Architecture Layer" />
                                                </Column>
                                                <Column width="240px" hAlign="Center">
                                                    <Text text="Deduplication Action" />
                                                </Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem>
                                                    <cells>
                                                        <Text text="{bulkModel>tableName}" class="sapUiBold" />
                                                        <ObjectStatus
                                                            text="{= ${bulkModel>referenceCount} + ' Views' }"
                                                            state="{= ${bulkModel>referenceCount} > 1 ? 'Warning' : 'None' }" />
                                                        <Text text="{= ${bulkModel>referencedByViews} ? ${bulkModel>referencedByViews}.join(', ') : '' }" />
                                                        <Text text="{= ${bulkModel>sharedColumns} ? ${bulkModel>sharedColumns}.slice(0, 6).join(', ') + (${bulkModel>sharedColumns}.length > 6 ? '...' : '') : '' }" />
                                                        <ObjectStatus
                                                            text="{bulkModel>suggestedLayer}"
                                                            state="{= ${bulkModel>suggestedLayer} === 'SHARED_DIMENSION' ? 'Success' : (${bulkModel>suggestedLayer} === 'SHARED_LOCAL_TABLE' ? 'Warning' : 'Information') }" />
                                                        <!-- Segmented Button for BLOCK vs KEEP -->
                                                        <SegmentedButton
                                                            selectedKey="{bulkModel>decision}"
                                                            selectionChange=".onDecisionChange">
                                                            <items>
                                                                <SegmentedButtonItem key="BLOCK" text="Block (Merge)" icon="sap-icon://accept" />
                                                                <SegmentedButtonItem key="KEEP" text="Keep (Duplicate)" icon="sap-icon://copy" />
                                                            </items>
                                                        </SegmentedButton>
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>

                                        <!-- Step 2 Navigation Footer -->
                                        <Toolbar class="sapUiMediumMarginTop">
                                            <Button
                                                text="Back: View Catalog"
                                                icon="sap-icon://navigation-left-arrow"
                                                press=".onGoToStep1" />
                                            <ToolbarSpacer />
                                            <Button
                                                text="Generate Master Data Mart &amp; Replication Flow (Step 3)"
                                                icon="sap-icon://navigation-right-arrow"
                                                iconFirst="false"
                                                type="Emphasized"
                                                press=".onGoToStep3" />
                                        </Toolbar>
                                    </VBox>
                                </content>
                            </IconTabFilter>

                            <!-- ============================================================== -->
                            <!-- STEP 3: MASTER DATA MART & REPLICATION FLOW                    -->
                            <!-- ============================================================== -->
                            <IconTabFilter
                                key="tabGeneration"
                                icon="sap-icon://download-from-cloud"
                                text="3. Master Data Mart &amp; Replication Flows"
                                enabled="{bulkModel>/hasAnalyzed}">
                                <content>
                                    <VBox class="sapUiMediumMargin" busy="{bulkModel>/isGenerateBusy}" busyIndicatorDelay="0">
                                        <!-- Header Configuration Panel -->
                                        <Panel headerText="Datasphere Enterprise Generation Settings" expandable="false" class="sapUiSmallMarginBottom">
                                            <content>
                                                <form:SimpleForm
                                                    editable="true"
                                                    layout="ResponsiveGridLayout"
                                                    labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12">
                                                    <form:content>
                                                        <Label text="Datasphere Space" />
                                                        <Input value="{bulkModel>/space}" editable="false" />
                                                        <Label text="Source Connection" />
                                                        <Input value="{bulkModel>/sourceConnection}" placeholder="e.g. S4HANA_SOURCE" />
                                                        <Label text="Target Container" />
                                                        <Text text="Local Tables (Replication targets space Local Tables directly)" class="sapUiBold text-success" />
                                                        <Label text="Column Naming Pattern" />
                                                        <SegmentedButton selectedKey="{bulkModel>/namingPattern}">
                                                            <items>
                                                                <SegmentedButtonItem key="DEFAULT" text="Preserve Original" />
                                                                <SegmentedButtonItem key="PASCAL" text="PascalCase" />
                                                                <SegmentedButtonItem key="UPPER_SNAKE" text="UPPER_SNAKE" />
                                                            </items>
                                                        </SegmentedButton>
                                                    </form:content>
                                                </form:SimpleForm>
                                                <HBox justifyContent="End" class="sapUiSmallMarginTop">
                                                    <Button
                                                        text="Generate Master Data Mart Deliverables"
                                                        icon="sap-icon://synchronize"
                                                        type="Emphasized"
                                                        press=".onGenerateArtifacts" />
                                                </HBox>
                                            </content>
                                        </Panel>

                                        <!-- RESULTS SECTION (WHEN GENERATED) -->
                                        <VBox visible="{bulkModel>/hasGeneratedBulk}" class="sapUiSmallMarginTop">

                                            <!-- DELIVERABLE 1: MASTER CSN DATA MART BUNDLE -->
                                            <Panel headerText="1. Master CSN Data Mart Bundle (HanaMorph_Enterprise_DataMart.csn.json)" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                                                <headerToolbar>
                                                    <OverflowToolbar>
                                                        <Title text="1. Master CSN Bundle ($version 2.0)" level="H5" />
                                                        <ToolbarSpacer />
                                                        <Button
                                                            text="Download Master CSN Bundle"
                                                            icon="sap-icon://download"
                                                            type="Emphasized"
                                                            press=".onDownloadMasterCsn" />
                                                        <Button
                                                            text="Copy CSN JSON"
                                                            icon="sap-icon://copy"
                                                            press=".onCopyMasterCsn" />
                                                    </OverflowToolbar>
                                                </headerToolbar>
                                                <content>
                                                    <VBox>
                                                        <MessageStrip
                                                            text="Upload via Datasphere Data Builder -> Import Objects from CSN/JSON File. Contains all {bulkModel>/bulkResult/tableCount} base tables and {bulkModel>/bulkResult/viewCount} analytical fact views in a unified package."
                                                            type="Success"
                                                            showIcon="true"
                                                            class="sapUiTinyMarginBottom" />
                                                        <TextArea
                                                            value="{bulkModel>/bulkResult/masterCsnJsonString}"
                                                            rows="10"
                                                            width="100%"
                                                            editable="false"
                                                            growing="true"
                                                            growingMaxLines="25" />
                                                    </VBox>
                                                </content>
                                            </Panel>

                                            <!-- DELIVERABLE 2: AGGREGATED SQL VIEW SCRIPT -->
                                            <Panel headerText="2. Aggregated Pure SQL Statements (All_Views_Datasphere.sql)" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                                                <headerToolbar>
                                                    <OverflowToolbar>
                                                        <Title text="2. Pure SQL Statements (SELECT queries for New SQL View)" level="H5" />
                                                        <ToolbarSpacer />
                                                        <Button
                                                            text="Download SQL Script"
                                                            icon="sap-icon://download"
                                                            type="Default"
                                                            press=".onDownloadAggregatedSql" />
                                                        <Button
                                                            text="Copy SQL Script"
                                                            icon="sap-icon://copy"
                                                            press=".onCopyAggregatedSql" />
                                                    </OverflowToolbar>
                                                </headerToolbar>
                                                <content>
                                                    <VBox>
                                                        <MessageStrip
                                                            text="Each statement starts directly with pure SELECT (no CREATE VIEW wrapper or comments) so it can be pasted directly into the Datasphere Data Builder -> New SQL View editor canvas."
                                                            type="Information"
                                                            showIcon="true"
                                                            class="sapUiTinyMarginBottom" />
                                                        <TextArea
                                                            value="{bulkModel>/bulkResult/aggregatedSql}"
                                                            rows="10"
                                                            width="100%"
                                                            editable="false"
                                                            growing="true"
                                                            growingMaxLines="25" />
                                                    </VBox>
                                                </content>
                                            </Panel>

                                            <!-- DELIVERABLE 3: REPLICATION FLOW TARGETING LOCAL TABLES -->
                                            <Panel headerText="3. Replication Flow Definition to Local Tables (HanaMorph_ReplicationFlow.json)" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                                                <headerToolbar>
                                                    <OverflowToolbar>
                                                        <Title text="3. Replication Flow (Target: Local Tables in AIS_HARMONIZATION_)" level="H5" />
                                                        <ToolbarSpacer />
                                                        <Button
                                                            text="Download Replication Flow JSON"
                                                            icon="sap-icon://download"
                                                            type="Emphasized"
                                                            press=".onDownloadReplicationFlow" />
                                                        <Button
                                                            text="Copy CLI Command"
                                                            icon="sap-icon://copy"
                                                            press=".onCopyReplicationCli" />
                                                    </OverflowToolbar>
                                                </headerToolbar>
                                                <content>
                                                    <VBox>
                                                        <MessageStrip
                                                            text="Replicates source objects directly into Datasphere Local Tables. Master Data (e.g. MARA, T001W, KNA1) is configured as Initial snapshot load; Transactional Data (e.g. VBAK, VBAP, AFRU) is configured as InitialAndDelta CDC real-time load."
                                                            type="Information"
                                                            showIcon="true"
                                                            class="sapUiTinyMarginBottom" />
                                                        <TextArea
                                                            value="{bulkModel>/bulkResult/replicationFlowJsonString}"
                                                            rows="10"
                                                            width="100%"
                                                            editable="false"
                                                            growing="true"
                                                            growingMaxLines="25" />
                                                        
                                                        <HBox alignItems="Center" class="sapUiSmallMarginTop">
                                                            <Text text="Datasphere CLI Deployment Command:" class="sapUiBold sapUiSmallMarginEnd" />
                                                            <Text text="{bulkModel>/bulkResult/replicationFlowCliCommand}" class="sapUiCode" />
                                                        </HBox>
                                                    </VBox>
                                                </content>
                                            </Panel>

                                        </VBox>

                                        <!-- Step 3 Navigation Footer -->
                                        <Toolbar class="sapUiMediumMarginTop">
                                            <Button
                                                text="Back: Deduplication Canvas"
                                                icon="sap-icon://navigation-left-arrow"
                                                press=".onGoToStep2" />
                                            <ToolbarSpacer />
                                            <Button
                                                text="Start Over"
                                                icon="sap-icon://refresh"
                                                press=".onGoToStep1" />
                                        </Toolbar>
                                    </VBox>
                                </content>
                            </IconTabFilter>

                        </items>
                    </IconTabBar>

                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>