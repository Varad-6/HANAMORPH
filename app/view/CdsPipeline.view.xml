<mvc:View
    controllerName="hanamorph.controller.CdsPipeline"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form">
    <Page
        id="cdsPipelinePage"
        title="{i18n>tileCdsTitle} Migration Studio"
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true">
        <headerContent>
            <ObjectStatus
                text="{i18n>connStatusMock}"
                state="Warning"
                icon="sap-icon://alert"
                visible="{system>/useMock}"
                class="sapUiSmallMarginEnd" />
            <ObjectStatus
                text="{= ${system>/hanaConnected} ? ${i18n>connStatusConnected} : ${i18n>connStatusDisconnected} }"
                state="{= ${system>/hanaConnected} ? 'Success' : 'Error' }"
                icon="{= ${system>/hanaConnected} ? 'sap-icon://connected' : 'sap-icon://disconnected' }" />
        </headerContent>
        <content>
            <VBox width="100%" alignItems="Center" class="sapUiMediumMarginTop sapUiLargeMarginBottom">
                <VBox width="96%" class="sapUiResponsiveMargin">

                    <!-- 5-STEP SEQUENTIAL WIZARD TABS -->
                    <IconTabBar
                        id="pipelineTabBar"
                        selectedKey="{/selectedTabKey}"
                        select=".onTabSelect"
                        headerMode="Inline"
                        expandable="false"
                        applyContentPadding="false">
                        <items>

                            <!-- ============================================================== -->
                            <!-- TAB 1: SELECT CDS VIEW (LIVE MODULE FILTER & SEARCH)           -->
                            <!-- ============================================================== -->
                            <IconTabFilter
                                key="tabSelectView"
                                icon="sap-icon://source-code"
                                text="1. Select CDS View"
                                count="{= ${/selectedViewName} ? '1' : '' }">
                                <content>
                                    <VBox class="sapUiMediumMargin">
                                        <Panel headerText="Live S/4HANA CDS View Discovery" expandable="false" class="sapUiSmallMarginBottom">
                                            <content>
                                                <VBox busy="{/isBusy}" busyIndicatorDelay="0">
                                                    
                                                    <!-- Filter & Search Bar Toolbar -->
                                                    <HBox alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                                                        <!-- Module Filter -->
                                                        <VBox class="sapUiSmallMarginEnd">
                                                            <Label text="SAP Module" class="sapUiTinyMarginBottom" />
                                                            <Select
                                                                id="moduleSelector"
                                                                selectedKey="{/selectedModule}"
                                                                change=".onModuleChange"
                                                                width="240px">
                                                                <core:Item key="ALL" text="🌐 All Modules" />
                                                                <core:Item key="MM" text="📦 MM - Materials Mgmt" />
                                                                <core:Item key="SD" text="📈 SD - Sales &amp; Distribution" />
                                                                <core:Item key="FI" text="💰 FI - Financial Accounting" />
                                                                <core:Item key="CO" text="📊 CO - Controlling &amp; Costs" />
                                                                <core:Item key="PP" text="🏭 PP - Production Planning" />
                                                                <core:Item key="CUSTOM" text="⚙️ Custom (Z* / Y*)" />
                                                            </Select>
                                                        </VBox>

                                                        <!-- Live Search Field -->
                                                        <VBox class="sapUiSmallMarginEnd" width="380px">
                                                            <Label text="Search CDS Views (Live Type-ahead)" class="sapUiTinyMarginBottom" />
                                                            <SearchField
                                                                id="liveViewSearch"
                                                                value="{/searchQuery}"
                                                                placeholder="e.g. Sales, Purchase, /1BS/*, Invoice..."
                                                                liveChange=".onLiveSearch"
                                                                search=".onTriggerSearch"
                                                                width="100%" />
                                                        </VBox>

                                                        <!-- Refresh / Query Status -->
                                                        <VBox class="sapUiSmallMarginTop">
                                                            <Label text="" class="sapUiTinyMarginBottom" />
                                                            <Button
                                                                text="Search"
                                                                icon="sap-icon://search"
                                                                type="Emphasized"
                                                                press=".onTriggerSearch" />
                                                        </VBox>
                                                    </HBox>

                                                    <!-- Live Results Table (Top 50-80 matches) -->
                                                    <Table
                                                        id="viewsResultTable"
                                                        items="{/views}"
                                                        mode="SingleSelectMaster"
                                                        selectionChange=".onTableSelectionChange"
                                                        noDataText="No views found. Enter a keyword above to search live in S/4HANA (HDD)."
                                                        growing="true"
                                                        growingThreshold="20"
                                                        class="sapUiSmallMarginBottom">
                                                        <headerToolbar>
                                                            <Toolbar>
                                                                <Title text="Matching CDS Entities ({= ${/views} ? ${/views}.length : 0 })" level="H5" />
                                                                <ToolbarSpacer />
                                                                <Text text="Select a row to inspect and prepare for migration" class="text-muted" />
                                                            </Toolbar>
                                                        </headerToolbar>
                                                        <columns>
                                                            <Column width="35%">
                                                                <Text text="CDS Entity Name" class="sapUiBold" />
                                                            </Column>
                                                            <Column width="25%">
                                                                <Text text="SQL View Name" class="sapUiBold" />
                                                            </Column>
                                                            <Column width="20%">
                                                                <Text text="Schema / Module" class="sapUiBold" />
                                                            </Column>
                                                            <Column width="20%">
                                                                <Text text="Status" class="sapUiBold" />
                                                            </Column>
                                                        </columns>
                                                        <items>
                                                            <ColumnListItem vAlign="Middle" type="Active">
                                                                <cells>
                                                                    <ObjectIdentifier title="{name}" text="{description}" />
                                                                    <Text text="{sqlViewName}" />
                                                                    <Text text="{packageOrSchema}" />
                                                                    <ObjectStatus text="{supportedStatus}" state="Success" />
                                                                </cells>
                                                            </ColumnListItem>
                                                        </items>
                                                    </Table>

                                                    <MessageStrip
                                                        text="{/errorViewsText}"
                                                        type="Error"
                                                        showIcon="true"
                                                        visible="{/hasError}"
                                                        class="sapUiSmallMarginTop" />

                                                    <!-- Selected View Summary Card -->
                                                    <VBox visible="{/hasViewSelected}" class="sapUiMediumMarginTop">
                                                        <Panel headerText="Selected View Ready for Extraction" expandable="false">
                                                            <form:SimpleForm
                                                                editable="false"
                                                                layout="ResponsiveGridLayout"
                                                                labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12">
                                                                <form:content>
                                                                    <Label text="CDS Entity Name" />
                                                                    <Text text="{/selectedView/name}" class="sapUiBold" />
                                                                    <Label text="SQL View Name" />
                                                                    <Text text="{/selectedView/sqlViewName}" />
                                                                    <Label text="Package / Schema" />
                                                                    <Text text="{/selectedView/packageOrSchema}" />
                                                                    <Label text="Description / Grain" />
                                                                    <Text text="{/selectedView/description}" />
                                                                    <Label text="Extraction Status" />
                                                                    <ObjectStatus text="Verified in S/4HANA Catalog" state="Success" icon="sap-icon://sys-enter-2" />
                                                                </form:content>
                                                            </form:SimpleForm>
                                                        </Panel>
                                                    </VBox>
                                                </VBox>
                                            </content>
                                        </Panel>

                                        <!-- Step 1 Navigation Footer -->
                                        <Toolbar class="sapUiSmallMarginTop">
                                            <ToolbarSpacer />
                                            <Button
                                                text="Next: Select Artifacts"
                                                type="Emphasized"
                                                icon="sap-icon://navigation-right-arrow"
                                                iconFirst="false"
                                                enabled="{/hasViewSelected}"
                                                press=".onGoToArtifacts" />
                                        </Toolbar>
                                    </VBox>
                                </content>
                            </IconTabFilter>

                            <!-- ============================================================== -->
                            <!-- TAB 2: ARTIFACTS SELECTION                                     -->
                            <!-- ============================================================== -->
                            <IconTabFilter
                                key="tabArtifacts"
                                icon="sap-icon://documents"
                                text="2. Artifacts"
                                count="{= ${/artifacts} ? ${/artifacts}.length : '' }">
                                <content>
                                    <VBox class="sapUiMediumMargin">
                                        <Panel headerText="Component Artifacts for Selected View" expandable="false">
                                            <content>
                                                <VBox busy="{/isArtifactsBusy}" busyIndicatorDelay="0">
                                                    <Text
                                                        text="Select the structural elements to extract from '{/selectedViewName}'. Each artifact generates native Datasphere-compatible models."
                                                        class="sapUiSmallMarginBottom text-muted" />

                                                    <Table
                                                        id="artifactsTable"
                                                        items="{/artifacts}"
                                                        mode="MultiSelect"
                                                        selectionChange=".onArtifactSelectionChange">
                                                        <columns>
                                                            <Column width="20%">
                                                                <Text text="Artifact Type" class="sapUiBold" />
                                                            </Column>
                                                            <Column width="30%">
                                                                <Text text="Artifact Name" class="sapUiBold" />
                                                            </Column>
                                                            <Column width="50%">
                                                                <Text text="Details" class="sapUiBold" />
                                                            </Column>
                                                        </columns>
                                                        <items>
                                                            <ColumnListItem selected="true">
                                                                <cells>
                                                                    <ObjectStatus
                                                                        text="{artifactType}"
                                                                        state="{= ${artifactType} === 'TABLE' ? 'Success' : (${artifactType} === 'SQL' ? 'Information' : 'Warning') }" />
                                                                    <Text text="{name}" class="sapUiBold" />
                                                                    <Text text="{details}" />
                                                                </cells>
                                                            </ColumnListItem>
                                                        </items>
                                                    </Table>
                                                </VBox>
                                            </content>
                                        </Panel>

                                        <!-- Step 2 Navigation Footer -->
                                        <Toolbar class="sapUiSmallMarginTop">
                                            <Button
                                                text="Back: Select View"
                                                icon="sap-icon://navigation-left-arrow"
                                                press=".onGoToSelectView" />
                                            <ToolbarSpacer />
                                            <Button
                                                text="Next: Columns"
                                                type="Emphasized"
                                                icon="sap-icon://navigation-right-arrow"
                                                iconFirst="false"
                                                enabled="{= ${/selectedArtifactCount} > 0 }"
                                                press=".onGoToColumns" />
                                        </Toolbar>
                                    </VBox>
                                </content>
                            </IconTabFilter>

                            <!-- ============================================================== -->
                            <!-- TAB 3: COLUMNS CUSTOMIZATION                                   -->
                            <!-- ============================================================== -->
                            <IconTabFilter
                                key="tabColumns"
                                icon="sap-icon://table-column"
                                text="3. Columns"
                                count="{= ${/selectedColumnCount} ? ${/selectedColumnCount} : '' }">
                                <content>
                                    <VBox class="sapUiMediumMargin">
                                        <Panel headerText="Column Customization, Renaming &amp; Mapping" expandable="false">
                                            <content>
                                                <VBox busy="{/isColumnsBusy}" busyIndicatorDelay="0">
                                                    <Toolbar class="sapUiSmallMarginBottom">
                                                        <SearchField
                                                            placeholder="Filter columns by name..."
                                                            value="{/columnSearchTerm}"
                                                            liveChange=".onSearchColumns"
                                                            width="320px" />
                                                        <ToolbarSpacer />
                                                        <Button
                                                            text="Select All"
                                                            icon="sap-icon://multiselect-all"
                                                            press=".onSelectAllColumns"
                                                            class="sapUiSmallMarginEnd" />
                                                        <Button
                                                            text="Deselect All"
                                                            icon="sap-icon://clear-all"
                                                            press=".onDeselectAllColumns"
                                                            class="sapUiSmallMarginEnd" />
                                                        <Text text="{/selectedColumnCount} of {/totalColumnCount} columns selected" class="sapUiBold text-muted" />
                                                    </Toolbar>

                                                    <Table
                                                        id="columnsTable"
                                                        items="{/columns}">
                                                        <columns>
                                                            <Column width="8%" hAlign="Center">
                                                                <Text text="Include" class="sapUiBold" />
                                                            </Column>
                                                            <Column width="22%">
                                                                <Text text="Source Column (HANA)" class="sapUiBold" />
                                                            </Column>
                                                            <Column width="25%">
                                                                <Text text="Target Technical Name" class="sapUiBold" />
                                                            </Column>
                                                            <Column width="25%">
                                                                <Text text="Business Label (Datasphere)" class="sapUiBold" />
                                                            </Column>
                                                            <Column width="10%">
                                                                <Text text="Data Type" class="sapUiBold" />
                                                            </Column>
                                                            <Column width="10%" hAlign="Center">
                                                                <Text text="Semantics" class="sapUiBold" />
                                                            </Column>
                                                        </columns>
                                                        <items>
                                                            <ColumnListItem vAlign="Middle">
                                                                <cells>
                                                                    <CheckBox selected="{selected}" select=".onColumnCheckboxChange" />
                                                                    <Text text="{sourceName}" />
                                                                    <Input value="{targetName}" />
                                                                    <Input value="{targetLabel}" />
                                                                    <Text text="{dataType}" class="text-muted" />
                                                                    <HBox justifyContent="Center">
                                                                        <core:Icon
                                                                            src="sap-icon://key"
                                                                            color="#e67e22"
                                                                            tooltip="Primary Key"
                                                                            visible="{isKey}"
                                                                            class="sapUiTinyMarginEnd" />
                                                                        <core:Icon
                                                                            src="sap-icon://measure"
                                                                            color="#27ae60"
                                                                            tooltip="Measure"
                                                                            visible="{isMeasure}" />
                                                                    </HBox>
                                                                </cells>
                                                            </ColumnListItem>
                                                        </items>
                                                    </Table>
                                                </VBox>
                                            </content>
                                        </Panel>

                                        <!-- Step 3 Navigation Footer -->
                                        <Toolbar class="sapUiSmallMarginTop">
                                            <Button
                                                text="Back: Artifacts"
                                                icon="sap-icon://navigation-left-arrow"
                                                press=".onGoToArtifacts" />
                                            <ToolbarSpacer />
                                            <Button
                                                text="Next: Object Naming"
                                                type="Emphasized"
                                                icon="sap-icon://navigation-right-arrow"
                                                iconFirst="false"
                                                enabled="{= ${/selectedColumnCount} > 0 }"
                                                press=".onGoToNaming" />
                                        </Toolbar>
                                    </VBox>
                                </content>
                            </IconTabFilter>

                            <!-- ============================================================== -->
                            <!-- TAB 4: OBJECT NAMING                                           -->
                            <!-- ============================================================== -->
                            <IconTabFilter
                                key="tabNaming"
                                icon="sap-icon://edit"
                                text="4. Object Naming">
                                <content>
                                    <VBox class="sapUiMediumMargin">
                                        <Panel headerText="Datasphere Space &amp; Target Technical Names" expandable="false">
                                            <content>
                                                <form:SimpleForm
                                                    editable="true"
                                                    layout="ResponsiveGridLayout"
                                                    labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12">
                                                    <form:content>
                                                        <core:Title text="Datasphere Space" />
                                                        <Label text="Target Space" />
                                                        <Input value="{/naming/space}" placeholder="AIS_HARMONIZATION_" />

                                                        <core:Title text="Base Ingestion Table" />
                                                        <Label text="Technical Table Name" />
                                                        <Input value="{/naming/tableName}" />
                                                        <Label text="Business Name" />
                                                        <Input value="{/naming/tableBusinessName}" />

                                                        <core:Title text="Analytical View Configuration" />
                                                        <Label text="Semantic Usage" />
                                                        <Select selectedKey="{/naming/semanticUsage}">
                                                            <core:Item key="FACT" text="Fact (Analytical Cube with Measures)" />
                                                            <core:Item key="DIMENSION" text="Dimension (Master Data / Attributes)" />
                                                            <core:Item key="RELATIONAL" text="Relational Dataset" />
                                                        </Select>
                                                        <Label text="Technical View Name" />
                                                        <Input value="{/naming/viewNameCustom}" />
                                                        <Label text="Business Name" />
                                                        <Input value="{/naming/viewBusinessName}" />

                                                        <core:Title text="Analytic Model (Reporting)" />
                                                        <Label text="Technical Model Name" />
                                                        <Input value="{/naming/amName}" />
                                                        <Label text="Business Name" />
                                                        <Input value="{/naming/amBusinessName}" />
                                                    </form:content>
                                                </form:SimpleForm>
                                            </content>
                                        </Panel>

                                        <!-- Step 4 Navigation Footer -->
                                        <Toolbar class="sapUiSmallMarginTop">
                                            <Button
                                                text="Back: Columns"
                                                icon="sap-icon://navigation-left-arrow"
                                                press=".onGoToColumns" />
                                            <ToolbarSpacer />
                                            <Button
                                                text="Generate Artifacts"
                                                type="Emphasized"
                                                icon="sap-icon://process"
                                                press=".onGenerateArtifacts" />
                                        </Toolbar>
                                    </VBox>
                                </content>
                            </IconTabFilter>

                            <!-- ============================================================== -->
                            <!-- TAB 5: VIEW CODE & DOWNLOADS                                   -->
                            <!-- ============================================================== -->
                            <IconTabFilter
                                key="tabCodeDownloads"
                                icon="sap-icon://download-from-cloud"
                                text="5. View Code &amp; Downloads">
                                <content>
                                    <VBox class="sapUiMediumMargin">
                                        <!-- Actions Toolbar -->
                                        <Panel headerText="Datasphere CSN &amp; SQL Export Files" expandable="false" class="sapUiSmallMarginBottom">
                                            <content>
                                                <VBox>
                                                    <Text text="Directly download native CSN/JSON files for SAP Datasphere Data Builder (Import from CSN/JSON File) or copy pure SQL statements for the New SQL View canvas." class="text-muted sapUiSmallMarginBottom" />
                                                    <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                                                        <Button
                                                            text="📦 Complete CSN Package (.json)"
                                                            icon="sap-icon://download"
                                                            type="Emphasized"
                                                            press=".onDownloadPackageJson"
                                                            class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                                                        <Button
                                                            text="📊 Fact View CSN (.json)"
                                                            icon="sap-icon://download"
                                                            press=".onDownloadViewJson"
                                                            class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                                                        <Button
                                                            text="🧊 Standalone Fact CSN (.json)"
                                                            icon="sap-icon://download"
                                                            press=".onDownloadStandaloneFactJson"
                                                            class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                                                        <Button
                                                            text="📈 Analytic Model CSN (.json)"
                                                            icon="sap-icon://download"
                                                            press=".onDownloadAmJson"
                                                            class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                                                        <Button
                                                            text="📄 Table CSN (.json)"
                                                            icon="sap-icon://download"
                                                            press=".onDownloadTableJson"
                                                            class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                                                        <Button
                                                            text="📜 Pure SELECT Query (.sql)"
                                                            icon="sap-icon://download"
                                                            press=".onDownloadCompleteSql"
                                                            class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                                                        <Button
                                                            text="📋 Copy SQL"
                                                            icon="sap-icon://copy"
                                                            press=".onCopySql"
                                                            class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                                                        <Button
                                                            text="{i18n>btnTransfer}"
                                                            icon="sap-icon://upload-to-cloud"
                                                            type="Accept"
                                                            press=".onDeployDirect"
                                                            class="sapUiTinyMarginBottom" />
                                                    </HBox>
                                                </VBox>
                                            </content>
                                        </Panel>

                                        <!-- Code Viewer -->
                                        <Panel headerText="Pure SQL Canvas Query" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                                            <content>
                                                <TextArea
                                                    value="{/modularResult/optimizedSql}"
                                                    rows="8"
                                                    width="100%"
                                                    editable="false" />
                                            </content>
                                        </Panel>

                                        <Panel headerText="Datasphere Unified CSN Definition" expandable="true" expanded="false">
                                            <content>
                                                <TextArea
                                                    value="{/modularResult/packageJsonString}"
                                                    rows="10"
                                                    width="100%"
                                                    editable="false" />
                                            </content>
                                        </Panel>

                                        <!-- Step 5 Navigation Footer -->
                                        <Toolbar class="sapUiSmallMarginTop">
                                            <Button
                                                text="Back: Naming"
                                                icon="sap-icon://navigation-left-arrow"
                                                press=".onGoToNaming" />
                                            <ToolbarSpacer />
                                            <Button
                                                text="Return to Studios"
                                                icon="sap-icon://home"
                                                press=".onNavBack" />
                                        </Toolbar>
                                    </VBox>
                                </content>
                            </IconTabFilter>

                        </items>
                    </IconTabBar>

                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
