<mvc:View
    controllerName="hanamorph.controller.ReplicationStudio"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form">
    <Page
        id="replicationStudioPage"
        title="Replication Flow Studio (Deduplication &amp; Multi-Object Target Harmonization)"
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true">
        <headerContent>
            <ObjectStatus
                text="{i18n>connStatusConnected}"
                state="Success"
                icon="sap-icon://connected"
                class="sapUiSmallMarginEnd" />
        </headerContent>
        <content>
            <VBox width="100%" alignItems="Center" class="sapUiMediumMarginTop sapUiLargeMarginBottom">
                <VBox width="96%" class="sapUiResponsiveMargin">
                    
                    <!-- Overview Banner & Visual Step Roadmap -->
                    <Panel headerText="Automated Harmonization &amp; Data Pipeline (From S/4HANA ➔ To SAP Datasphere: {/targetSpace})" expandable="false" class="sapUiSmallMarginBottom">
                        <content>
                            <VBox class="sapUiSmallMargin">
                                <HBox alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                                    <ObjectStatus text="Step 1: Pick Source Objects" state="Information" icon="sap-icon://source-code" class="sapUiSmallMarginEnd sapUiBold" />
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="sapUiSmallMarginEnd text-muted" />
                                    <ObjectStatus text="Step 2: Remove Duplicates &amp; Name Target Tables" state="Information" icon="sap-icon://chain-link" class="sapUiSmallMarginEnd sapUiBold" />
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="sapUiSmallMarginEnd text-muted" />
                                    <ObjectStatus text="Step 3: Review Columns &amp; Delta Keys" state="Information" icon="sap-icon://table-view" class="sapUiSmallMarginEnd sapUiBold" />
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="sapUiSmallMarginEnd text-muted" />
                                    <ObjectStatus text="Step 4: Download Files or Deploy Live" state="Success" icon="sap-icon://begin" class="sapUiBold" />
                                </HBox>
                                <Text text="💡 How It Works in Simple Terms: When you pick views from S/4HANA, they often share the exact same underlying database tables (e.g., ACDOCA or BNKA). Instead of creating wasteful duplicate copies in Datasphere, HanaMorph finds the underlying tables, combines their fields into a single canonical table, and keeps the name 100% identical across the Table Blueprint (CSN) and the Data Pipeline (Replication Flow)." class="text-muted" />
                            </VBox>
                        </content>
                    </Panel>

                    <!-- STEP 1: SOURCE OBJECT SELECTION & METADATA EXPLORER -->
                    <Panel headerText="Step 1: Select Source Views or Tables from S/4HANA" expandable="false" class="sapUiSmallMarginBottom">
                        <content>
                            <VBox busy="{/isViewsBusy}">
                                <!-- Source Connection Indicator -->
                                <HBox alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                                    <Label text="Source Connection (S/4HANA):" class="sapUiSmallMarginEnd sapUiBold" />
                                    <Input value="{/sourceConnection}" width="220px" placeholder="S4HANA_SOURCE" change=".onConfigChange" class="sapUiMediumMarginEnd" />
                                    <ObjectStatus text="Connected to SAP S/4HANA DB" state="Success" icon="sap-icon://connected" class="sapUiMediumMarginEnd" />
                                    <Label text="Target Space in Datasphere:" class="sapUiSmallMarginEnd sapUiBold" />
                                    <Input value="{/targetSpace}" width="180px" placeholder="AIS_INBOUND" change=".onConfigChange" />
                                </HBox>

                                <!-- Filter and Action Bar -->
                                <OverflowToolbar class="sapUiSmallMarginBottom">
                                    <Label text="Source Type Filter:" class="sapUiTinyMarginTop sapUiSmallMarginEnd" />
                                    <SegmentedButton selectedKey="{/selectedViewCategory}" selectionChange=".onCategoryFilterChange" class="sapUiSmallMarginEnd">
                                        <items>
                                            <SegmentedButtonItem key="ALL" text="All Source Objects ({/allViewsCount})" />
                                            <SegmentedButtonItem key="CALC_VIEW" text="Calculation Views ({/calcViewsCount})" />
                                            <SegmentedButtonItem key="CDS" text="CDS Views ({/cdsViewsCount})" />
                                        </items>
                                    </SegmentedButton>

                                    <SearchField
                                        width="280px"
                                        placeholder="Search source objects..."
                                        value="{/viewSearchTerm}"
                                        liveChange=".onSearchView"
                                        search=".onSearchView"
                                        class="sapUiSmallMarginEnd" />

                                    <Button
                                        text="Select All Visible"
                                        icon="sap-icon://multiselect-all"
                                        press=".onSelectAllVisibleViews"
                                        class="sapUiTinyMarginEnd" />

                                    <Button
                                        text="Deselect All"
                                        icon="sap-icon://clear-all"
                                        press=".onDeselectAllViews"
                                        class="sapUiTinyMarginEnd" />

                                    <Button
                                        text="Refresh Source Catalog"
                                        icon="sap-icon://synchronize"
                                        press=".onRefreshViews" />

                                    <ToolbarSpacer />

                                    <ObjectStatus
                                        text="{= ${/selectedViewsCount} + ' of ' + ${/allViewsCount} + ' Source Objects Selected' }"
                                        state="{= ${/selectedViewsCount} > 0 ? 'Success' : 'Warning' }"
                                        icon="sap-icon://checklist-item"
                                        class="sapUiSmallMarginEnd sapUiBold" />
                                </OverflowToolbar>

                                <!-- Source Object Catalog Table with Checkboxes & Inspect Action -->
                                <Table
                                    id="viewsCatalogTable"
                                    items="{/filteredViews}"
                                    growing="true"
                                    growingThreshold="40"
                                    noDataText="No source objects found matching the filter."
                                    class="sapUiSmallMarginBottom">
                                    <columns>
                                        <Column width="65px" hAlign="Center">
                                            <CheckBox select=".onToggleSelectAllVisible" tooltip="Toggle All Visible" />
                                        </Column>
                                        <Column width="300px">
                                            <Text text="Source Object Name (HANA)" />
                                        </Column>
                                        <Column width="170px">
                                            <Text text="Extraction Type" />
                                        </Column>
                                        <Column width="180px">
                                            <Text text="Source Container" />
                                        </Column>
                                        <Column width="220px">
                                            <Text text="Source Fields &amp; Keys" />
                                        </Column>
                                        <Column width="160px" hAlign="Center">
                                            <Text text="Source Inspection" />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <CheckBox
                                                    selected="{isSelected}"
                                                    select=".onViewCheckboxChange"
                                                    tooltip="Include this Source Object in Replication Flow" />
                                                <VBox>
                                                    <HBox alignItems="Center">
                                                        <core:Icon
                                                            src="{= ${type} === 'CDS' ? 'sap-icon://table-view' : 'sap-icon://dimension' }"
                                                            class="sapUiTinyMarginEnd"
                                                            color="{= ${type} === 'CDS' ? '#107e3e' : '#0070f2' }" />
                                                        <Link
                                                            text="{name}"
                                                            press=".onViewLinkPress"
                                                            class="sapUiBold"
                                                            tooltip="Click to inspect source fields and keys below" />
                                                    </HBox>
                                                    <Text text="{description}" class="text-muted sapUiTinyMarginTop" maxLines="1" />
                                                </VBox>
                                                <ObjectStatus
                                                    text="{= ${type} === 'CDS' ? 'CDS View' : 'Calculation View' }"
                                                    icon="{= ${type} === 'CDS' ? 'sap-icon://table-view' : 'sap-icon://dimension' }"
                                                    state="{= ${type} === 'CDS' ? 'Success' : 'Information' }" />
                                                <Text text="SAPHANADB" class="sapUiBold" />
                                                <ObjectStatus
                                                    text="{= ${configuredColumnsCount} > 0 ? (${selectedColsCount} + ' of ' + ${configuredColumnsCount} + ' fields (' + ${keyColsCount} + ' keys)') : 'Default (All fields &amp; keys)' }"
                                                    state="{= ${keyColsCount} > 0 ? 'Success' : 'None' }" />
                                                <Button
                                                    text="{= ${name} === ${/activeViewName} ? 'Inspecting 🔍' : 'Inspect 🔍' }"
                                                    icon="sap-icon://search"
                                                    type="{= ${name} === ${/activeViewName} ? 'Emphasized' : 'Default' }"
                                                    press=".onConfigureViewPress"
                                                    tooltip="Inspect source fields, keys and mappings" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </content>
                    </Panel>

                    <!-- STEP 2: DEDUPLICATED PHYSICAL TABLES & TARGET OBJECT MAPPING MATRIX -->
                    <Panel
                        id="deduplicatedTablesPanel"
                        headerText="{= 'Step 2: Harmonized Target Tables in Datasphere (' + ${/deduplicatedTablesCount} + ' Unique Tables from ' + ${/selectedViewsCount} + ' Source Objects)' }"
                        expandable="true"
                        expanded="true"
                        class="sapUiSmallMarginBottom">
                        <content>
                            <VBox busy="{/isDeduplicationBusy}">
                                <Text text="🔍 No More Duplicate Tables: Instead of copying the same table multiple times (for example, creating 15 copies of ACDOCA), HanaMorph merges them into one single canonical table. You can edit the Target Table Technical Name and Business Label below — whatever name you type here is automatically matched in the CSN Table Blueprint and the Replication Flow pipeline." class="text-muted sapUiSmallMarginBottom" />

                                <OverflowToolbar class="sapUiTinyMarginBottom">
                                    <core:Icon src="sap-icon://chain-link" color="#0070f2" class="sapUiSmallMarginEnd" />
                                    <Title text="Target Tables List (What will be created in Datasphere)" level="H5" />
                                    <ToolbarSpacer />
                                    <ObjectStatus
                                        text="{= ${/deduplicatedTablesCount} + ' Unique Table(s) to Create | ' + ${/deduplicatedOverlapsCount} + ' Duplicate(s) Saved' }"
                                        state="{= ${/deduplicatedOverlapsCount} > 0 ? 'Success' : 'Information' }"
                                        icon="sap-icon://accelerated"
                                        class="sapUiSmallMarginEnd sapUiBold" />
                                    <Button text="Re-analyze Tables" icon="sap-icon://synchronize" press=".onReanalyzeDeduplication" />
                                </OverflowToolbar>

                                <Table
                                    id="deduplicatedTablesTable"
                                    items="{/deduplicatedTables}"
                                    growing="true"
                                    growingThreshold="30"
                                    noDataText="Select one or more source objects in Step 1 to detect physical base tables.">
                                    <columns>
                                        <Column width="50px" hAlign="Center"><Text text="Include" /></Column>
                                        <Column width="160px"><Text text="Original Source Table" /></Column>
                                        <Column width="250px"><Text text="Datasphere Table Technical Name" /></Column>
                                        <Column width="250px"><Text text="Friendly Business Description" /></Column>
                                        <Column width="220px"><Text text="Used by These Views" /></Column>
                                        <Column width="100px"><Text text="Total Fields" /></Column>
                                        <Column width="170px"><Text text="How to Load Data" /></Column>
                                        <Column width="140px" hAlign="Center"><Text text="View Fields" /></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <CheckBox selected="{selected}" select=".onDeduplicatedTableSelectChange" tooltip="Include this table in the package" />
                                                <HBox alignItems="Center">
                                                    <core:Icon src="sap-icon://database" class="sapUiTinyMarginEnd" color="#107e3e" />
                                                    <VBox>
                                                        <Text text="{sourceTable}" class="sapUiBold" />
                                                        <ObjectStatus text="{= ${category} === 'MasterData' ? 'Master Data' : 'Transactional Data' }" state="{= ${category} === 'MasterData' ? 'Information' : 'Warning' }" class="sapUiTinyMarginTop" />
                                                    </VBox>
                                                </HBox>
                                                <VBox>
                                                    <Input value="{targetTable}" change=".onTargetTableNameChange" placeholder="e.g. ACDOCA_TBL" tooltip="Technical ID inside Datasphere. Synced 100% with CSN and Flow JSON." />
                                                    <Text text="Same name used in CSN and Replication Flow" class="text-muted sapUiTinyMarginTop" />
                                                </VBox>
                                                <VBox>
                                                    <Input value="{businessName}" change=".onTargetBusinessNameChange" placeholder="e.g. Accounting Ledger Records" />
                                                </VBox>
                                                <VBox>
                                                    <ObjectStatus
                                                        text="{= ${isDeduplicated} ? (${referencingViewCount} + ' Views (Harmonized ⚡)') : (${referencingViewCount} + ' View') }"
                                                        state="{= ${isDeduplicated} ? 'Success' : 'None' }"
                                                        icon="{= ${isDeduplicated} ? 'sap-icon://chain-link' : 'sap-icon://document' }"
                                                        class="sapUiBold" />
                                                    <Text text="{referencingViewsSummary}" class="text-muted sapUiTinyMarginTop" maxLines="2" />
                                                </VBox>
                                                <ObjectStatus text="{= ${columnCount} + ' fields' }" state="None" />
                                                <Select selectedKey="{loadType}" change=".onTableLoadTypeChange">
                                                    <core:Item key="InitialAndDelta" text="⚡ Initial Snapshot + Live Changes (CDC)" />
                                                    <core:Item key="Initial" text="📦 One-Time Copy (Initial Only)" />
                                                    <core:Item key="Delta" text="🔄 Changes Only (Delta)" />
                                                </Select>
                                                <Button
                                                    text="{= ${sourceTable} === ${/activeDeduplicatedTable} ? 'Viewing 🔍' : 'View Fields 🔍' }"
                                                    icon="sap-icon://search"
                                                    type="{= ${sourceTable} === ${/activeDeduplicatedTable} ? 'Emphasized' : 'Default' }"
                                                    press=".onInspectDeduplicatedTablePress" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </content>
                    </Panel>

                    <!-- STEP 3: SUPERSET COLUMN DRILLDOWN & DELTA KEY HARMONIZATION -->
                    <Panel
                        id="columnsPanel"
                        headerText="{= 'Step 3: Table Fields &amp; Change Tracking Keys: \'' + ${/activeDeduplicatedTable} + '\' ➔ \'' + ${/activeDeduplicatedTargetTable} + '\'' }"
                        expandable="true"
                        expanded="true"
                        class="sapUiSmallMarginBottom">
                        <content>
                            <VBox busy="{/isColumnsBusy}">
                                <Text text="Combined Fields (Superset): These are all the fields merged from every view that uses '{/activeDeduplicatedTable}'. The 'Delta Key' switch tells SAP Datasphere which columns uniquely identify each record so it can automatically track and replicate new or modified rows in real time." class="text-muted sapUiSmallMarginBottom" />

                                <OverflowToolbar class="sapUiTinyMarginBottom">
                                    <core:Icon src="sap-icon://table-view" class="sapUiSmallMarginEnd" color="#0070f2" />
                                    <Title text="{= 'Table: ' + ${/activeDeduplicatedTable} + ' (Datasphere Name: ' + ${/activeDeduplicatedTargetTable} + ')' }" level="H5" />
                                    <ToolbarSpacer />
                                    <ObjectStatus
                                        text="{= ${/activeTableSelectedColumnCount} + ' of ' + ${/activeTableTotalColumnCount} + ' Fields Extracted (' + ${/activeTableKeyColumnCount} + ' Change Tracking Keys)' }"
                                        state="{= ${/activeTableKeyColumnCount} > 0 ? 'Success' : 'Warning' }"
                                        class="sapUiSmallMarginEnd sapUiBold" />
                                    <Button text="Select All Fields" icon="sap-icon://multiselect-all" press=".onSelectAllTableColumns" />
                                    <Button text="Keys &amp; Measures Only" icon="sap-icon://key" press=".onSelectKeysOnlyTableColumns" />
                                    <Button text="Reset Fields" icon="sap-icon://reset" press=".onResetTableColumns" />
                                </OverflowToolbar>

                                <Table id="columnsTable" items="{/activeTableColumns}" growing="true" growingThreshold="60" noDataText="Click 'View Fields 🔍' on any table in Step 2 to inspect its columns.">
                                    <columns>
                                        <Column width="75px" hAlign="Center"><Text text="Include" /></Column>
                                        <Column width="260px"><Text text="Original Field Name (HANA)" /></Column>
                                        <Column width="240px"><Text text="Datasphere Column Name" /></Column>
                                        <Column width="180px"><Text text="Data Type" /></Column>
                                        <Column width="150px" hAlign="Center"><Text text="Delta Key (isKey)" /></Column>
                                        <Column><Text text="Change Tracking Role" /></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <CheckBox selected="{selected}" select=".onColumnCheckboxChange" />
                                                <Text text="{sourceName}" class="sapUiBold" />
                                                <Input value="{targetName}" change=".onColumnTargetNameChange" />
                                                <ObjectStatus text="{dataType}" state="None" />
                                                <Switch state="{isKey}" change=".onKeySwitchChange" customTextOn="KEY" customTextOff="-" />
                                                <ObjectStatus
                                                    text="{= ${isKey} ? 'Primary Key: Identifies row updates in real time' : 'Standard field' }"
                                                    state="{= ${isKey} ? 'Success' : 'None' }" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </content>
                    </Panel>

                    <!-- STEP 4: CONFIGURE REPLICATION FLOW (BINDS SOURCE OBJECT ➔ DATASPHERE) -->
                    <Panel headerText="Step 4: Package &amp; Download (Table Schemas &amp; Replication Pipeline)" expandable="false" class="sapUiSmallMarginBottom">
                        <content>
                            <VBox>
                                <form:SimpleForm
                                    editable="true"
                                    layout="ResponsiveGridLayout"
                                    labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12">
                                    <form:content>
                                        <Label text="Data Pipeline Name (Replication Flow)" required="true" />
                                        <Input value="{/flowTechnicalName}" placeholder="RF_INBOUND_PIPELINE" change=".onConfigChange" />

                                        <Label text="Default Replication Mode" required="true" />
                                        <Select selectedKey="{/loadMode}" change=".onLoadModeChange">
                                            <core:Item key="INITIAL_AND_DELTA" text="⚡ INITIAL_AND_DELTA (Copy All Data + Stream Live Changes)" />
                                            <core:Item key="INITIAL" text="📦 INITIAL (One-Time Static Snapshot)" />
                                            <core:Item key="DELTA" text="🔄 DELTA (Stream Incremental Changes Only)" />
                                        </Select>
                                    </form:content>
                                </form:SimpleForm>

                                <!-- Action Toolbar -->
                                <Toolbar class="sapUiSmallMarginTop">
                                    <Button
                                        text="⚡ Generate Package"
                                        icon="sap-icon://syntax"
                                        type="Emphasized"
                                        press=".onGenerateDefinitions"
                                        class="sapUiSmallMarginEnd sapUiBold" />
                                    <Button
                                        text="📦 Download Tables CSN (.csn.json)"
                                        icon="sap-icon://download"
                                        type="Default"
                                        press=".onDownloadTableCsn"
                                        class="sapUiSmallMarginEnd sapUiBold"
                                        enabled="{/hasGenerated}"
                                        tooltip="Downloads the Table Blueprint (CSN file). Import this into SAP Datasphere Data Builder to create the local tables." />
                                    <Button
                                        text="🌊 Download Flow JSON (.replicationFlow.json)"
                                        icon="sap-icon://attachment"
                                        press=".onDownloadFlowJson"
                                        class="sapUiSmallMarginEnd sapUiBold"
                                        enabled="{/hasGenerated}"
                                        tooltip="Downloads the Replication Flow pipeline definition. Uses the exact same table names as the CSN file." />
                                    <Button
                                        text="🧊 Download Standalone Fact CSN (.json)"
                                        icon="sap-icon://cube"
                                        type="Default"
                                        press=".onDownloadStandaloneFactCsn"
                                        class="sapUiSmallMarginEnd"
                                        tooltip="Downloads ready-to-use Fact View without base table dependencies." />
                                    <Button
                                        text="📋 Copy View SQL"
                                        icon="sap-icon://syntax"
                                        type="Default"
                                        press=".onCopyActiveViewSql"
                                        class="sapUiSmallMarginEnd"
                                        tooltip="Copy Pure SELECT SQL statement to paste directly into Datasphere New SQL View" />
                                    <Button
                                        text="📋 Copy CLI Commands"
                                        icon="sap-icon://copy"
                                        press=".onCopyCliCommands"
                                        class="sapUiSmallMarginEnd"
                                        enabled="{/hasGenerated}" />
                                </Toolbar>
                            </VBox>
                        </content>
                    </Panel>

                    <!-- STEP 5: DEPLOY REPLICATION FLOW & LIVE INGESTION -->
                    <Panel headerText="Step 5: Deploy Replication Flow &amp; Start Ingestion in Datasphere (Phase 1 ➔ Phase 5)" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                        <content>
                            <VBox class="sapUiSmallMargin">
                                <!-- Trigger Buttons -->
                                <Toolbar class="sapUiSmallMarginBottom">
                                    <Button
                                        text="🚀 Deploy Replication Flow &amp; Start Ingestion"
                                        icon="sap-icon://begin"
                                        type="Accept"
                                        press=".onDeployAndRun"
                                        busy="{/isDeploying}"
                                        enabled="{/hasGenerated}"
                                        class="sapUiSmallMarginEnd sapUiBold"
                                        tooltip="Deploy native Replication Flow into Space AIS_INBOUND and run live data ingestion" />
                                    <Button
                                        text="Trigger Ingestion Task ▶️"
                                        icon="sap-icon://play"
                                        press=".onRunReplicationTaskOnly"
                                        class="sapUiSmallMarginEnd"
                                        enabled="{/hasGenerated}"
                                        tooltip="Run the replication task in Datasphere" />
                                    <Button
                                        text="Check Flow Status 🔄"
                                        icon="sap-icon://synchronize"
                                        type="Default"
                                        press=".onCheckStatus"
                                        enabled="{/hasDeployed}" />
                                </Toolbar>

                                <HBox alignItems="Center" class="sapUiSmallMarginBottom" wrap="Wrap">
                                    <Label text="Pipeline Stage:" class="sapUiSmallMarginEnd sapUiBold" />
                                    <ObjectStatus
                                        text="{/executionStatusText}"
                                        state="{/executionStatusState}"
                                        icon="{/executionStatusIcon}"
                                        class="sapUiMediumMarginEnd" />

                                    <Label text="Source Connection:" class="sapUiSmallMarginEnd" />
                                    <ObjectStatus text="{/sourceConnection}" state="Information" class="sapUiMediumMarginEnd" />

                                    <Label text="Target Space:" class="sapUiSmallMarginEnd" />
                                    <ObjectStatus text="{/targetSpace}" state="Information" class="sapUiMediumMarginEnd" />

                                    <Label text="Canonical Target Tables:" class="sapUiSmallMarginEnd" />
                                    <ObjectStatus text="{= ${/deduplicatedTablesCount} + ' Tables' }" state="Success" class="sapUiMediumMarginEnd" />

                                    <Label text="Flow:" class="sapUiSmallMarginEnd" />
                                    <ObjectStatus text="{/flowTechnicalName}" state="None" />
                                </HBox>

                                <MessageStrip
                                    text="{/executionLogSummary}"
                                    type="{/executionLogType}"
                                    showIcon="true"
                                    visible="{= ${/executionLogSummary} !== '' }"
                                    class="sapUiSmallMarginBottom" />

                                <!-- Terminal Console Box -->
                                <TextArea
                                    value="{/terminalLogText}"
                                    rows="9"
                                    width="100%"
                                    editable="false"
                                    class="sapUiCode"
                                    placeholder="Terminal output: Phase 1 (Validate Source Object &amp; Connection) -> Phase 2 (Bind Source Object into Replication Flow) -> Phase 3 (Deploy Native Replication Flow to Space AIS_INBOUND) -> Phase 4 (Execute Ingestion Task) -> Phase 5 (Real-Time CDC Active)..." />
                            </VBox>
                        </content>
                    </Panel>

                    <!-- SECTION 6: ARTIFACT PREVIEWS (TABS) -->
                    <Panel headerText="Generated Native Datasphere Payloads &amp; CLI Commands" expandable="true" expanded="false">
                        <content>
                            <IconTabBar headerMode="Inline" expandable="false">
                                <items>
                                    <IconTabFilter text="Native Replication Flow JSON" icon="sap-icon://syntax">
                                        <TextArea
                                            value="{/flowJsonString}"
                                            rows="15"
                                            width="100%"
                                            editable="false"
                                            placeholder="Generated Replication Flow JSON with Target Object definitions..." />
                                    </IconTabFilter>
                                    <IconTabFilter text="Target Tables CSN JSON" icon="sap-icon://table-view">
                                        <TextArea
                                            value="{/tableCsnString}"
                                            rows="15"
                                            width="100%"
                                            editable="false"
                                            placeholder="Generated Target Tables CSN JSON with synchronized table definitions..." />
                                    </IconTabFilter>
                                    <IconTabFilter text="Datasphere CLI Commands" icon="sap-icon://command-line-interfaces">
                                        <VBox class="sapUiSmallMargin">
                                            <Label text="1. Create Target Local Tables via CLI:" class="sapUiBold" />
                                            <TextArea value="{/cliTableCommand}" rows="4" width="100%" editable="false" class="sapUiSmallMarginBottom sapUiCode" />
                                            <Label text="2. Create Native Replication Flow via CLI:" class="sapUiBold" />
                                            <Input value="{/cliCreateCommand}" editable="false" class="sapUiSmallMarginBottom" />
                                            <Label text="3. Start Real-Time Data Ingestion Task:" class="sapUiBold" />
                                            <Input value="{/cliRunCommand}" editable="false" />
                                        </VBox>
                                    </IconTabFilter>
                                </items>
                            </IconTabBar>
                        </content>
                    </Panel>

                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
