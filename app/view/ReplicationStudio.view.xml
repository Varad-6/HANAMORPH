<mvc:View
    controllerName="hanamorph.controller.ReplicationStudio"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form">
    <Page
        id="replicationStudioPage"
        title="Replication Flow Studio"
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true">
        <headerContent>
            <ObjectStatus
                text="{i18n>connStatusConnected}"
                state="Success"
                icon="sap-icon://connected" />
        </headerContent>
        <content>
            <VBox width="100%" alignItems="Center" class="sapUiMediumMarginTop sapUiLargeMarginBottom">
                <VBox width="96%" class="sapUiResponsiveMargin">

                    <!-- Header Info Card -->
                    <Panel headerText="Datasphere Direct Ingestion &amp; Replication Flow Studio" expandable="false" class="sapUiSmallMarginBottom">
                        <content>
                            <Text text="Generate and deploy native SAP Datasphere Replication Flows for SAP S/4HANA CDS Views, Calculation Views, or direct physical tables into Datasphere Local Tables (Space: {/space}). Replicates initial snapshots and ongoing change data." class="text-muted sapUiSmallMarginBottom" />
                        </content>
                    </Panel>

                    <!-- IconTabBar for 3 Modes -->
                    <IconTabBar
                        id="replicationTabBar"
                        selectedKey="{/activeTab}"
                        select=".onTabSelect"
                        headerMode="Inline"
                        expandable="false"
                        applyContentPadding="false">
                        <items>

                            <!-- ============================================================== -->
                            <!-- TAB 1: SINGLE CDS / CALC VIEW                                  -->
                            <!-- ============================================================== -->
                            <IconTabFilter
                                key="singleView"
                                icon="sap-icon://source-code"
                                text="1. Single CDS / View Flow"
                                count="{= ${/singleView/selectedName} ? '1' : '' }">
                                <content>
                                    <VBox class="sapUiMediumMargin">
                                        <!-- Search & Selection Panel -->
                                        <Panel headerText="Select Source CDS or Calculation View" expandable="false" class="sapUiSmallMarginBottom">
                                            <content>
                                                <VBox busy="{/isSearchingViews}">
                                                    <HBox alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                                                        <SearchField
                                                            value="{/viewSearchQuery}"
                                                            placeholder="Search CDS or Calc View (e.g. BANK, BKPF, MARA...)"
                                                            liveChange=".onLiveSearchViews"
                                                            search=".onTriggerSearchViews"
                                                            width="380px"
                                                            class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                                                        <Select selectedKey="{/viewTypeFilter}" change=".onTriggerSearchViews" width="180px" class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                                            <core:Item key="ALL" text="🌐 All Types" />
                                                            <core:Item key="CDS" text="📘 CDS Views" />
                                                            <core:Item key="CALC_VIEW" text="📊 Calc Views" />
                                                        </Select>
                                                        <Button text="Search" icon="sap-icon://search" type="Emphasized" press=".onTriggerSearchViews" class="sapUiTinyMarginBottom" />
                                                    </HBox>

                                                    <Table
                                                        items="{/matchingViews}"
                                                        mode="SingleSelectMaster"
                                                        selectionChange=".onSingleViewSelect"
                                                        growing="true"
                                                        growingThreshold="10"
                                                        noDataText="Search and select a view above.">
                                                        <columns>
                                                            <Column width="35%"><Text text="View Technical Name" class="sapUiBold" /></Column>
                                                            <Column width="20%"><Text text="Type" class="sapUiBold" /></Column>
                                                            <Column width="45%"><Text text="Description / Package" class="sapUiBold" /></Column>
                                                        </columns>
                                                        <items>
                                                            <ColumnListItem vAlign="Middle" type="Active">
                                                                <cells>
                                                                    <ObjectIdentifier title="{name}" text="{sqlViewName}" />
                                                                    <ObjectStatus text="{type}" state="{= ${type} === 'CDS' ? 'Information' : 'Success' }" />
                                                                    <Text text="{description}" />
                                                                </cells>
                                                            </ColumnListItem>
                                                        </items>
                                                    </Table>
                                                </VBox>
                                            </content>
                                        </Panel>

                                        <!-- Selected View Config & Actions -->
                                        <Panel
                                            headerText="Replication Flow Parameters for '{/singleView/selectedName}'"
                                            expandable="false"
                                            visible="{= !!${/singleView/selectedName} }"
                                            class="sapUiSmallMarginBottom">
                                            <content>
                                                <form:SimpleForm
                                                    editable="true"
                                                    layout="ResponsiveGridLayout"
                                                    labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12">
                                                    <form:content>
                                                        <core:Title text="Connection &amp; Target Space" />
                                                        <Label text="Source Connection ID" />
                                                        <Input value="{/sourceConnection}" placeholder="HDD_HANA_SOURCE" />
                                                        <Label text="Source Container" />
                                                        <Input value="{/container}" placeholder="SAPHANADB" />
                                                        <Label text="Target Datasphere Space" />
                                                        <Input value="{/space}" placeholder="AIS_HARMONIZATION_" />
                                                        <Label text="Replication Flow Name" />
                                                        <Input value="{/singleView/flowName}" placeholder="RF_VIEW_INGESTION" />
                                                    </form:content>
                                                </form:SimpleForm>

                                                <HBox class="sapUiSmallMarginTop sapUiSmallMarginBottom" wrap="Wrap">
                                                    <Button
                                                        text="⚡ Generate RF JSON"
                                                        icon="sap-icon://process"
                                                        type="Emphasized"
                                                        press=".onGenerateSingleViewRF"
                                                        busy="{/singleView/isBusy}"
                                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                                                    <Button
                                                        text="⬇ Download RF JSON"
                                                        icon="sap-icon://download"
                                                        press=".onDownloadSingleViewRF"
                                                        enabled="{/singleView/hasGenerated}"
                                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                                                    <Button
                                                        text="🚀 Deploy to Datasphere"
                                                        icon="sap-icon://upload-to-cloud"
                                                        type="Accept"
                                                        press=".onDeploySingleViewRF"
                                                        enabled="{/singleView/hasGenerated}"
                                                        class="sapUiTinyMarginBottom" />
                                                </HBox>

                                                <!-- Auto-Detected Source Objects Table -->
                                                <Panel
                                                    headerText="Auto-Detected Underlying Tables ({/singleView/sourceObjects/length})"
                                                    expandable="true"
                                                    expanded="true"
                                                    visible="{/singleView/hasGenerated}"
                                                    class="sapUiTinyMarginBottom">
                                                    <content>
                                                        <Table items="{/singleView/sourceObjects}">
                                                            <columns>
                                                                <Column width="30%"><Text text="Source Physical Table" class="sapUiBold" /></Column>
                                                                <Column width="30%"><Text text="Target Local Table" class="sapUiBold" /></Column>
                                                                <Column width="20%"><Text text="Columns" class="sapUiBold" /></Column>
                                                                <Column width="20%"><Text text="Load Mode" class="sapUiBold" /></Column>
                                                            </columns>
                                                            <items>
                                                                <ColumnListItem vAlign="Middle">
                                                                    <cells>
                                                                        <ObjectIdentifier title="{sourceObject}" />
                                                                        <Text text="{targetObject}" class="sapUiBold" />
                                                                        <Text text="{mappingCount}" />
                                                                        <ObjectStatus text="{loadType}" state="Information" icon="sap-icon://arrow-right" />
                                                                    </cells>
                                                                </ColumnListItem>
                                                            </items>
                                                        </Table>
                                                    </content>
                                                </Panel>

                                                <!-- RF JSON Preview -->
                                                <Panel headerText="RF JSON Preview" expandable="true" expanded="false" visible="{/singleView/hasGenerated}">
                                                    <content>
                                                        <TextArea value="{/singleView/jsonString}" rows="10" width="100%" editable="false" />
                                                    </content>
                                                </Panel>
                                            </content>
                                        </Panel>
                                    </VBox>
                                </content>
                            </IconTabFilter>

                            <!-- ============================================================== -->
                            <!-- TAB 2: MULTIPLE CDS VIEWS (BULK INGESTION)                     -->
                            <!-- ============================================================== -->
                            <IconTabFilter
                                key="multiView"
                                icon="sap-icon://documents"
                                text="2. Multiple CDS Cart"
                                count="{= ${/cartViews} ? ${/cartViews}.length : '' }">
                                <content>
                                    <VBox class="sapUiMediumMargin">
                                        <Panel headerText="Accumulate CDS Views for Bulk Replication" expandable="false" class="sapUiSmallMarginBottom">
                                            <content>
                                                <Text text="Select multiple CDS views to generate individual Replication Flows (1 per view) or review all unique underlying tables across the selected portfolio." class="text-muted sapUiSmallMarginBottom" />
                                                <Toolbar class="sapUiSmallMarginBottom">
                                                    <Title text="Cart Items ({= ${/cartViews} ? ${/cartViews}.length : 0 })" level="H5" />
                                                    <ToolbarSpacer />
                                                    <Button text="Clear Cart" icon="sap-icon://delete" press=".onClearCart" enabled="{= !!${/cartViews} &amp;&amp; ${/cartViews}.length > 0 }" class="sapUiSmallMarginEnd" />
                                                    <Button text="Add Selected Single View" icon="sap-icon://add" press=".onAddSingleViewToCart" enabled="{= !!${/singleView/selectedName} }" />
                                                </Toolbar>

                                                <Table items="{/cartViews}" noDataText="No views in cart. Select views from Tab 1 and click 'Add to Cart'.">
                                                    <columns>
                                                        <Column width="40%"><Text text="View Name" class="sapUiBold" /></Column>
                                                        <Column width="20%"><Text text="Type" class="sapUiBold" /></Column>
                                                        <Column width="30%"><Text text="Target RF Technical Name" class="sapUiBold" /></Column>
                                                        <Column width="10%" hAlign="Center"><Text text="Action" class="sapUiBold" /></Column>
                                                    </columns>
                                                    <items>
                                                        <ColumnListItem vAlign="Middle">
                                                            <cells>
                                                                <ObjectIdentifier title="{name}" text="{description}" />
                                                                <ObjectStatus text="{type}" state="Information" />
                                                                <Text text="RF_{name}" />
                                                                <Button icon="sap-icon://decline" type="Reject" press=".onRemoveFromCart" />
                                                            </cells>
                                                        </ColumnListItem>
                                                    </items>
                                                </Table>
                                            </content>
                                        </Panel>

                                        <!-- Bulk Action Toolbar -->
                                        <Toolbar class="sapUiSmallMarginBottom">
                                            <Button
                                                text="⚡ Generate All RF Definitions"
                                                icon="sap-icon://process"
                                                type="Emphasized"
                                                press=".onGenerateAllCartRFs"
                                                busy="{/isBulkBusy}"
                                                enabled="{= !!${/cartViews} &amp;&amp; ${/cartViews}.length > 0 }"
                                                class="sapUiSmallMarginEnd" />
                                            <Button
                                                text="⬇ Download All RFs (.zip)"
                                                icon="sap-icon://download"
                                                press=".onDownloadAllCartRFs"
                                                enabled="{/hasGeneratedBulk}"
                                                class="sapUiSmallMarginEnd" />
                                            <ToolbarSpacer />
                                            <Button
                                                text="🚀 Deploy All to Space {/space}"
                                                icon="sap-icon://upload-to-cloud"
                                                type="Accept"
                                                press=".onDeployAllCartRFs"
                                                enabled="{/hasGeneratedBulk}" />
                                        </Toolbar>

                                        <!-- Bulk Results List -->
                                        <Panel headerText="Generated Bulk Replication Flows ({/bulkResults/length})" expandable="true" expanded="true" visible="{/hasGeneratedBulk}">
                                            <content>
                                                <List items="{/bulkResults}">
                                                    <CustomListItem>
                                                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin">
                                                            <VBox>
                                                                <Text text="{rfTechName}" class="sapUiBold" />
                                                                <Text text="Source Tables: {sourceTableCount} | Targets: Local Tables in {space}" class="text-muted" />
                                                            </VBox>
                                                            <HBox>
                                                                <Button text="Download" icon="sap-icon://download" press=".onDownloadSingleBulkResult" class="sapUiTinyMarginEnd" />
                                                                <Button text="Deploy" icon="sap-icon://upload-to-cloud" type="Accept" press=".onDeploySingleBulkResult" />
                                                            </HBox>
                                                        </HBox>
                                                    </CustomListItem>
                                                </List>
                                            </content>
                                        </Panel>
                                    </VBox>
                                </content>
                            </IconTabFilter>

                            <!-- ============================================================== -->
                            <!-- TAB 3: AD-HOC DIRECT TABLES (CUSTOM INGESTION)                 -->
                            <!-- ============================================================== -->
                            <IconTabFilter
                                key="directTables"
                                icon="sap-icon://database"
                                text="3. Direct Tables">
                                <content>
                                    <VBox class="sapUiMediumMargin">
                                        <Panel headerText="Manual Physical Table Ingestion Form" expandable="false" class="sapUiSmallMarginBottom">
                                            <content>
                                                <form:SimpleForm
                                                    editable="true"
                                                    layout="ResponsiveGridLayout"
                                                    labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12">
                                                    <form:content>
                                                        <core:Title text="Datasphere Target Environment" />
                                                        <Label text="Datasphere Space" />
                                                        <Input value="{/space}" placeholder="AIS_HARMONIZATION_" />
                                                        <Label text="Flow Technical Name" />
                                                        <Input value="{/flowTechnicalName}" placeholder="RF_S4H_INGESTION" />
                                                        <Label text="Replication Mode" />
                                                        <Select selectedKey="{/replicationMode}">
                                                            <core:Item key="INITIAL" text="📦 Initial Only (Full Snapshot - For Master/Direct DB)" />
                                                            <core:Item key="DELTA" text="⚡ Initial &amp; Delta (CDC - When CDC available)" />
                                                        </Select>

                                                        <core:Title text="Source Connection &amp; Entities" />
                                                        <Label text="Source Connection ID" />
                                                        <Input value="{/sourceConnection}" placeholder="HDD_HANA_SOURCE" />
                                                        <Label text="Container / Schema" />
                                                        <Input value="{/container}" placeholder="SAPHANADB" />
                                                        <Label text="Source Tables (Comma-separated)" />
                                                        <Input value="{/sourceEntitiesString}" placeholder="BNKA, BKPF, MARA, EKKO..." />
                                                    </form:content>
                                                </form:SimpleForm>

                                                <HBox class="sapUiSmallMarginTop sapUiSmallMarginBottom" wrap="Wrap">
                                                    <Button
                                                        text="⚡ Generate Flow Definition"
                                                        icon="sap-icon://process"
                                                        type="Emphasized"
                                                        press=".onGenerateDirectFlowJson"
                                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                                                    <Button
                                                        text="⬇ Download Flow JSON"
                                                        icon="sap-icon://download"
                                                        press=".onDownloadDirectFlowJson"
                                                        enabled="{/hasDirectGenerated}"
                                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                                                    <Button
                                                        text="🚀 Deploy to Datasphere"
                                                        icon="sap-icon://upload-to-cloud"
                                                        type="Accept"
                                                        press=".onDeployDirectFlow"
                                                        enabled="{/hasDirectGenerated}"
                                                        class="sapUiTinyMarginBottom" />
                                                </HBox>

                                                <Panel headerText="JSON Definition Preview" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                                                    <content>
                                                        <TextArea value="{/flowJsonString}" rows="10" width="100%" editable="false" placeholder="Click Generate above..." />
                                                    </content>
                                                </Panel>

                                                <Panel headerText="CLI Deployment Command" expandable="true" expanded="false">
                                                    <content>
                                                        <HBox alignItems="Center">
                                                            <Input value="{/cliCommand}" width="85%" editable="false" class="sapUiSmallMarginEnd" />
                                                            <Button text="Copy" icon="sap-icon://copy" press=".onCopyCliCommand" />
                                                        </HBox>
                                                    </content>
                                                </Panel>
                                            </content>
                                        </Panel>
                                    </VBox>
                                </content>
                            </IconTabFilter>

                        </items>
                    </IconTabBar>

                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
