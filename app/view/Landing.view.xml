<mvc:View
    controllerName="hanamorph.controller.Landing"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout">
    <Page
        id="landingPage"
        title="{i18n>landingTitle}"
        showNavButton="false"
        enableScrolling="true">
        <headerContent>
            <!-- Visible MOCK DATA Badge -->
            <ObjectStatus
                text="{i18n>connStatusMock}"
                state="Warning"
                icon="sap-icon://alert"
                visible="{system>/useMock}"
                class="sapUiSmallMarginEnd" />
            
            <!-- Small Connection Status Indicator -->
            <ObjectStatus
                text="{= ${system>/hanaConnected} ? ${i18n>connStatusConnected} : ${i18n>connStatusDisconnected} }"
                state="{= ${system>/hanaConnected} ? 'Success' : 'Error' }"
                icon="{= ${system>/hanaConnected} ? 'sap-icon://connected' : 'sap-icon://disconnected' }" />
        </headerContent>
        <content>
            <VBox
                alignItems="Center"
                justifyContent="Center"
                class="sapUiLargeMarginTop sapUiLargeMarginBottom">
                
                <Title
                    text="Select Migration Pipeline"
                    level="H2"
                    class="sapUiMediumMarginBottom" />

                <!-- Two Large Selectable Tiles -->
                <HBox
                    wrap="Wrap"
                    justifyContent="Center"
                    alignItems="Center"
                    class="sapUiLargeMarginTop">
                    
                    <!-- CDS View Tile -->
                    <GenericTile
                        header="{i18n>tileCdsTitle}"
                        subheader="{i18n>tileCdsSubtitle}"
                        frameType="TwoByOne"
                        class="sapUiMediumMargin"
                        press=".onSelectCds">
                        <tileContent>
                            <TileContent>
                                <content>
                                    <VBox alignItems="Center" justifyContent="Center" height="100%">
                                        <core:Icon
                                            xmlns:core="sap.ui.core"
                                            src="sap-icon://source-code"
                                            size="3rem"
                                            color="#0a6ed1" />
                                    </VBox>
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <!-- Calculation View Tile -->
                    <GenericTile
                        header="{i18n>tileCalcTitle}"
                        subheader="{i18n>tileCalcSubtitle}"
                        frameType="TwoByOne"
                        class="sapUiMediumMargin"
                        press=".onSelectCalcView">
                        <tileContent>
                            <TileContent>
                                <content>
                                    <VBox alignItems="Center" justifyContent="Center" height="100%">
                                        <core:Icon
                                            xmlns:core="sap.ui.core"
                                            src="sap-icon://dimension"
                                            size="3rem"
                                            color="#6366f1" />
                                    </VBox>
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                </HBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
