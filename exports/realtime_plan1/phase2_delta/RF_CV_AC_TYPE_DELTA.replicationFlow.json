        },
        {
          "sourceColumn": "ACC_CURRENT",
          "targetColumn": "ACC_CURRENT",
          "isKey": false
        },
        {
          "sourceColumn": "ACC_TYPE_DESC",
          "targetColumn": "ACC_TYPE_DESC",
          "isKey": false
        }
      ]
